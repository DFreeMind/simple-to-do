{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "易简清单",
  "version": "0.5.2",
  "identifier": "cn.duqimeng.simpletodo",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "易简清单",
        "width": 1200,
        "height": 800,
        "backgroundColor": "#f7fbfa",
        "minWidth": 900,
        "minHeight": 720
      },
      {
        "label": "focus-controller",
        "title": "易简清单 · 专注控制器",
        "url": "index.html",
        "width": 390,
        "height": 286,
        "minWidth": 390,
        "minHeight": 286,
        "maxWidth": 390,
        "maxHeight": 286,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "rhythm-controller",
        "title": "易简清单 · 节律控制器",
        "url": "index.html",
        "width": 390,
        "height": 86,
        "minWidth": 390,
        "minHeight": 86,
        "maxWidth": 390,
        "maxHeight": 86,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDNkQ1MDk3QjkxMTM1NDAKUldSQU5SRzVsMUJ0ekhWdjhCcktsR0FXSnAzMGljMndvV3hiYjE3Q3N5VDJGRzd3TWs0OTJiRE8K",
      "endpoints": [
        "https://simpletodo.duqimeng.cn/releases/latest.json",
        "https://github.com/DFreeMind/simple-to-do/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
